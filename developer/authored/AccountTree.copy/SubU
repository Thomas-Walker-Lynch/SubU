#!/usr/bin/env python3
# -*- mode: python; coding: utf-8; python-indent-offset: 2; indent-tabs-mode: nil -*-
"""
SubU

Manages the resources of users. A SubU, a subordinate user, belongs to
another user, its MasU, and every resource a user holds, its SubUs among
them, is allocated through this tool. root is the MasU at the top.

This is the application shell. It shows what exists and greys out every
option that has no implementation yet. It changes nothing, and runs with
the privileges of the user who started it.

Usage: SubU <command> [argument ...]
  help | -h | --help   print this message (also printed when given no arguments)
  window [<user>]      open the resource window for <user>, default yourself
  list [<user>]        print the SubUs of <user>, default yourself
  resource             print the kinds of resource, and which have an allocator
"""

import sys ,os
sys.path.insert(0 ,os.path.dirname(os.path.realpath(__file__)))

import account
import resource_kind


def print_help():
  print(__doc__.strip())
  return 0

def user_argument(rest ,command):
  if len(rest) > 1:
    print(f"Error: {command} takes at most one user name." ,file=sys.stderr)
    return None
  if not rest:
    return account.acting_account()
  user = account.account(rest[0])
  if user is None:
    print(f"Error: there is no user named '{rest[0]}'." ,file=sys.stderr)
  return user

def command_window(rest):
  user = user_argument(rest ,"window")
  if user is None: return 1
  import window
  return window.run(user ,account.acting_account())

def command_list(rest):
  user = user_argument(rest ,"list")
  if user is None: return 1
  for subu in account.subu_list(user.name):
    print(f"{subu.name:<24}{subu.uid:>7}  {subu.home}")
  return 0

def command_resource(rest):
  if rest:
    print("Error: resource takes no arguments." ,file=sys.stderr)
    return 1
  for group ,kind_list in resource_kind.kind_list_by_group():
    print(resource_kind.GROUP_TITLE[group])
    for kind in kind_list:
      state = "allocator" if kind.implemented else "not written"
      print(f"  {kind.name:<20}{state:<13}{kind.description}")
  return 0

COMMAND = {
  "window": command_window,
  "list": command_list,
  "resource": command_resource,
}

def CLI(argv=None):
  if argv is None: argv = sys.argv[1:]
  if not argv or argv[0] in ("help" ,"-h" ,"--help"): return print_help()
  command ,rest = argv[0] ,argv[1:]
  if command not in COMMAND:
    print(f"Error: unknown command '{command}'." ,file=sys.stderr)
    print_help()
    return 1
  return COMMAND[command](rest)


if __name__ == "__main__":
  sys.exit(CLI())
