#!/usr/bin/env python3
# -*- mode: python; coding: utf-8; python-indent-offset: 2; indent-tabs-mode: nil -*-
"""
SubU_admin

The superuser's program. It runs as root, and calls the work functions
directly, so it works whether or not the SubU server is running. Users make
and manage their own SubUs with the SubU program.

There are two kinds of database:
  system database    /var/lib/SubU/system.sqlite3, this system's own record,
                     identified by its system uuid. Its system map is the
                     authority for which storage users have accounts here.
  storage database   <SubU dir>/database.sqlite3, the users kept on a storage,
                     identified by its database uuid.

A storage is a persistent storage device: the disk inside the machine, or a
drive plugged in. Its SubU dir is <storage root>/home/SubU and holds the
storage database and user_data, the users' homes. On the disk the system runs
from, the SubU dir is /home/SubU; on a drive mounted at /mnt/Eagle it is
/mnt/Eagle/home/SubU.

A user specifier names a user in one place:
  system <host name> <account>     an account on this system
  storage <SubU dir> <user>        a user of the storage database in that SubU dir

Usage: SubU_admin <command> [argument ...]
       SubU_admin preview <command> [argument ...]
  help | -h | --help             print this message (also printed when given no arguments)

  system make [<first system uid> <last system uid>]
                                 make the system database, with a new system uuid and
                                 the range of system uids SubU gives out (default
                                 2000 to 59999)
  system show                    print the system database, and verify it
  system delete                  delete the system database; refused while any account
                                 is the same user as a storage user

  storage make <SubU dir>        make the SubU dir with an empty storage database and
                                 user_data
  storage show <SubU dir>        print the storage database, and verify it
  storage delete <SubU dir> [--user-data] [--forget-other-systems]
                                 undo on this system what SubU did for the storage
                                 database's users, then delete the SubU dir. Every
                                 check is made first, and a failed check changes
                                 nothing. Homes holding files are deleted only with
                                 --user-data

  user make <SubU dir> <name> [--uid <database uid>] [--masu <name>]
                                 make a user in the storage database, with its home in
                                 user_data; its database uid is the next counting down
                                 from 1999999999, or --uid keeps an existing uid

  is-same-user <user specifier> <user specifier> [--make-account]
                                 record in the system map that a system account and a
                                 storage user are the same user. The account is adopted
                                 when it exists; --make-account makes it, with a new
                                 system uid, when it does not
  is-not-same-user <user specifier> <user specifier>
                                 undo is-same-user: unmount the home, delete an account
                                 SubU made, keep an adopted one, retire the system uid
  same-user show [storage <SubU dir>]
                                 print who is the same user as whom on this system
  same-user suggest storage <SubU dir>
                                 print is-same-user commands proposed by matching names,
                                 to read and run; changes nothing

  attach <SubU dir>              mount the home of each storage user the system map
                                 names at /home/<account>, nosuid and nodev
  detach <SubU dir>              unmount them; refused for an account that is logged in

  limit set <account> <maximum>  set how many SubUs an account may have below it;
                                 an account with no limit set may have none

  preview <command>              print the log of what <command> would do, change nothing

The order on a new system: system make, storage make, user make, is-same-user,
attach. To undo: storage delete, then system delete.
"""

import sys ,os
sys.path.insert(0 ,os.path.dirname(os.path.realpath(__file__)))

import common
import system
import storage
import same_user
from database import DatabaseError

# first words that take a second word to make the command
OBJECT = ("system" ,"storage" ,"user" ,"same-user" ,"limit")

# commands that only read, and so may be run by anyone with read access
READ_ONLY = ("system show" ,"storage show" ,"same-user show" ,"same-user suggest")


def print_help():
  print(__doc__.strip())
  return 0

def flag_value(rest ,flag):
  """
  Remove '--flag value' from rest and return value, or None.
  """
  if flag in rest:
    i = rest.index(flag)
    if i + 1 >= len(rest):
      raise ValueError(f"{flag} needs a value")
    value = rest[i + 1]
    del rest[i:i + 2]
    return value
  return None

def flag_present(rest ,flag):
  if flag in rest:
    rest.remove(flag)
    return True
  return False

def integer(text ,what):
  try:
    return int(text)
  except ValueError:
    raise ValueError(f"{what} must be a whole number, not '{text}'")

def user_specifier_list(rest):
  """
  Parse user specifiers from rest: 'system <host name> <account>' and
  'storage <SubU dir> <user>'.
  """
  result = []
  i = 0
  while i < len(rest):
    kind = rest[i]
    if kind not in ("system" ,"storage") or i + 2 >= len(rest):
      raise ValueError(f"a user specifier is 'system <host name> <account>' or 'storage <SubU dir> <user>', not '{' '.join(rest[i:])}'")
    if kind == "system":
      result.append({"kind": "system" ,"host": rest[i + 1] ,"account": rest[i + 2]})
    else:
      result.append({"kind": "storage" ,"subu_dir": rest[i + 1] ,"user": rest[i + 2]})
    i += 3
  return result

def system_and_storage(specifier_list):
  """
  In 5.0, is-same-user relates a system account and a storage user, given in
  either order.
  """
  kind = sorted(s["kind"] for s in specifier_list)
  if len(specifier_list) != 2 or kind != ["storage" ,"system"]:
    raise ValueError("in 5.0 the two user specifiers are one system account and one storage user")
  system_spec = next(s for s in specifier_list if s["kind"] == "system")
  storage_spec = next(s for s in specifier_list if s["kind"] == "storage")
  return system_spec ,storage_spec

def CLI(argv=None):
  if argv is None: argv = sys.argv[1:]
  if not argv or argv[0] in ("help" ,"-h" ,"--help"): return print_help()

  preview = argv[0] == "preview"
  if preview: argv = argv[1:]
  if not argv:
    print("Error: 'preview' needs a command after it." ,file=sys.stderr)
    return 1

  command ,rest = argv[0] ,list(argv[1:])
  if command in OBJECT and rest:
    command ,rest = f"{command} {rest[0]}" ,rest[1:]

  if command not in READ_ONLY and os.geteuid() != 0 and not preview:
    print("Error: SubU_admin changes the system and must be run as root." ,file=sys.stderr)
    return 1

  log = common.Log(preview)
  try:
    # ---- read only
    if command == "system show" and not rest:
      return system.system_show()
    if command == "storage show" and len(rest) == 1:
      return storage.storage_show(rest[0])
    if command == "same-user show" and len(rest) in (0 ,2):
      if rest and rest[0] != "storage": return usage_error(command)
      return same_user.same_user_show({"subu_dir": rest[1]} if rest else None)
    if command == "same-user suggest" and len(rest) == 2 and rest[0] == "storage":
      return same_user.same_user_suggest({"subu_dir": rest[1]})

    # ---- changes
    if command == "system make" and len(rest) in (0 ,2):
      if rest:
        first ,last = integer(rest[0] ,"<first system uid>") ,integer(rest[1] ,"<last system uid>")
      else:
        first ,last = system.DEFAULT_SYSTEM_UID_FIRST ,system.DEFAULT_SYSTEM_UID_LAST
      header(command ,None ,preview)
      system.system_make(first ,last ,log ,preview)
    elif command == "system delete" and not rest:
      header(command ,None ,preview)
      system.system_delete(log ,preview)
    elif command == "storage make" and len(rest) == 1:
      header(command ,rest[0] ,preview)
      storage.storage_make(rest[0] ,log ,preview)
    elif command == "storage delete" and rest:
      user_data_too = flag_present(rest ,"--user-data")
      forget_other_systems = flag_present(rest ,"--forget-other-systems")
      if len(rest) != 1: return usage_error(command)
      header(command ,rest[0] ,preview)
      storage.storage_delete(rest[0] ,user_data_too ,forget_other_systems ,log ,preview)
    elif command == "user make" and len(rest) >= 2:
      database_uid = flag_value(rest ,"--uid")
      masu = flag_value(rest ,"--masu")
      if len(rest) != 2: return usage_error(command)
      header(command ,rest[0] ,preview)
      storage.user_make(rest[0] ,rest[1] ,integer(database_uid ,"--uid") if database_uid else None ,masu ,log ,preview)
    elif command == "is-same-user" and rest:
      make_account = flag_present(rest ,"--make-account")
      system_spec ,storage_spec = system_and_storage(user_specifier_list(rest))
      header(command ,None ,preview)
      same_user.is_same_user(system_spec ,storage_spec ,make_account ,log ,preview)
    elif command == "is-not-same-user" and rest:
      system_spec ,storage_spec = system_and_storage(user_specifier_list(rest))
      header(command ,None ,preview)
      same_user.is_not_same_user(system_spec ,storage_spec ,log ,preview)
    elif command == "attach" and len(rest) == 1:
      header(command ,rest[0] ,preview)
      storage.attach(rest[0] ,log ,preview)
    elif command == "detach" and len(rest) == 1:
      header(command ,rest[0] ,preview)
      storage.detach(rest[0] ,log ,preview)
    elif command == "limit set" and len(rest) == 2:
      header(command ,None ,preview)
      system.limit_set(rest[0] ,integer(rest[1] ,"<maximum>") ,log ,preview)
    else:
      return usage_error(command)
  except (DatabaseError ,ValueError) as error:
    log.error(command ,str(error))
  return log.summary()

def header(command ,subu_dir ,preview):
  where = f"   on {os.path.abspath(subu_dir)}" if subu_dir else ""
  print(f"SubU_admin {'preview ' if preview else ''}{command}{where}")

def usage_error(command):
  print(f"Error: unknown command or wrong arguments: '{command}'." ,file=sys.stderr)
  print("Run 'SubU_admin help' for the commands." ,file=sys.stderr)
  return 1


if __name__ == "__main__":
  sys.exit(CLI())
